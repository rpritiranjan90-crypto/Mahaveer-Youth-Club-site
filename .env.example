# ==============================================================================
# Mahaveer Youth Club — Environment Configuration Template
# Copy this file to .env before running the application locally.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# API Configuration
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Mahaveer Youth Club API"

# Security (Placeholder - Generate a secure random string for production)
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-byte-hex

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mahaveer_club_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahaveer_club_db

# Logging
LOG_LEVEL=INFO

# Future Integrations (Placeholders for future phases — not used in Phase 1)
PAYMENT_GATEWAY_KEY_ID=placeholder_key_id
PAYMENT_GATEWAY_KEY_SECRET=placeholder_key_secret
SMTP_HOST=smtp.placeholder.com
SMTP_PORT=587
SMTP_USER=placeholder_user
SMTP_PASSWORD=placeholder_password
