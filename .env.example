# =============================================================================
# Mahaveer Youth Club Banza V2 — Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this template to '.env' in the project root.
# 2. Update values according to your target deployment environment.
# 3. NEVER commit real secrets, production credentials, or '.env' to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Required: YES
# Options: development, staging, production, testing
# In 'production', APP_DEBUG is strictly enforced to False by system validators.
APP_ENV=development

# Application Name displayed in API responses, logs, and documentation
# Required: YES
APP_NAME=Mahaveer Youth Club Banza API

# Application Debug Mode (Verbose exception logs)
# Required: YES | In production: MUST be false
APP_DEBUG=true

# API Version Base URL Path Prefix
# Required: YES
API_V1_STR=/api/v1


# -----------------------------------------------------------------------------
# 2. SECURITY & CRYPTOGRAPHY
# -----------------------------------------------------------------------------
# Master Cryptographic Secret Key (Used for HMAC signing of JWT and challenge tokens)
# Required: YES | In production: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Constraint: MUST be >= 32 characters in production. Never use default values in production.
SECRET_KEY=change_this_to_a_secure_64_character_hex_random_key_in_production


# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Database Connection URI (SQLAlchemy connection string)
# Required: YES
# Local Development: sqlite:///./mahaveer.db
# Production: postgresql://mahaveer_user:STRONG_PASSWORD_HERE@localhost:5432/mahaveer_db
DATABASE_URL=sqlite:///./mahaveer.db

# Database Connection Pool Settings (Applicable to PostgreSQL in production)
# Required: NO (Defaults provided)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30


# -----------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# -----------------------------------------------------------------------------
# Allowed CORS Origins for Web Frontend
# Required: YES | Production constraint: Explicit HTTPS origins only. Wildcard '*' is forbidden with credentials.
# Format: JSON array string or comma-separated list
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]


# -----------------------------------------------------------------------------
# 5. AUTHENTICATION & SESSION LIFECYCLE
# -----------------------------------------------------------------------------
# JWT Access Token Expiry (in minutes)
# Required: NO (Default: 15 for high security, or 120 for extended admin sessions)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Refresh Token Expiry (in days, stored in HttpOnly SameSite cookies)
# Required: NO (Default: 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Superuser Email (Used during initial database bootstrap only)
# Required: NO
FIRST_SUPERUSER_EMAIL=admin@mahaveeryouthclub.org


# -----------------------------------------------------------------------------
# 6. STORAGE & UPLOAD LIMITS
# -----------------------------------------------------------------------------
# Base Upload Directory Path
# Required: NO (Default: uploads)
UPLOAD_DIR=uploads

# Maximum Upload File Size in Bytes (5 MB = 5242880 bytes)
# Required: NO (Default: 5242880)
MAX_UPLOAD_SIZE_BYTES=5242880


# -----------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Vite)
# -----------------------------------------------------------------------------
# Base API URL used by frontend client during build / runtime
# Required: YES (Used by frontend/.env or Vite build)
VITE_API_URL=http://127.0.0.1:8000/api/v1
