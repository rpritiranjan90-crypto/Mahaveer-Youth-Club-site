# =============================================================================
# Mahaveer Youth Club Banza V2 — Environment Configuration Template
# Copy this file to '.env' and populate with local development values.
# NEVER commit the active '.env' file or real production secrets to version control.
# =============================================================================

# Application Environment (development, staging, production, testing)
APP_ENV=development
APP_NAME="Mahaveer Youth Club Banza API"
APP_DEBUG=true
API_V1_STR=/api/v1

# Security & Secrets (Generate a 64-character random string in production)
SECRET_KEY=change_this_to_a_secure_random_string_for_local_development_only

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://mahaveer_user:mahaveer_pass@localhost:5432/mahaveer_db

# Allowed CORS Origins (Comma-separated URLs for web frontend)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Frontend API URL (Used by Vite during development)
VITE_API_URL=http://localhost:8000/api/v1
