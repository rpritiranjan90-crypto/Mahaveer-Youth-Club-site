# ==============================================================================
# Mahaveer Youth Club — Environment Configuration Template
# Copy this file to .env before running the application locally.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# API Server Configuration
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Mahaveer Youth Club API"

# Security & JWT Configuration
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-byte-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated or JSON list of origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL in production; SQLite supported for local development)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mahaveer_club_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahaveer_club_db
# For local SQLite development, set:
# DATABASE_URL=sqlite:///./mahaveer_club.db

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Logging
LOG_LEVEL=INFO

